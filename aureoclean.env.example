# AureoClean configuration.
# Copy to ~/.config/aureoclean/aureoclean.env (setup_pi.sh does this for you)
# and fill in the values. Keep this file and the service-account key OUT of the app folder.

# "firebase" for the real system, "local" to run offline with a SQLite file.
AUREOCLEAN_MODE=firebase

AUREOCLEAN_FIREBASE_PROJECT_ID=aureoclean-b7c2b
AUREOCLEAN_FIREBASE_WEB_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=~/.config/aureoclean/service-account.json

# Arduino IoT Cloud dashboard link (Arduino Cloud > Dashboards > open yours > copy the address bar).
# Shown inside the app in the Dashboard tab, for admins and janitors.
AUREOCLEAN_DASHBOARD_URL=

# SMS: "log" = test mode (nothing is sent; messages go to logs/sms_outbox.log)
#      "modem" = real GSM/LTE modem on the serial port below
# Easier: in the app, Tools -> "Find & use modem" (overrides these three lines).
AUREOCLEAN_SMS_MODE=log
# AUREOCLEAN_SMS_PORT=/dev/serial0
# AUREOCLEAN_SMS_BAUD=9600

# Optional settings (defaults shown)
# AUREOCLEAN_PORT=8765
# AUREOCLEAN_COLLECTION_PREFIX=aureo
# AUREOCLEAN_SESSION_HOURS=8
# AUREOCLEAN_ACTIVATION_HOURS=48
# AUREOCLEAN_INVITE_HOURS=24
# AUREOCLEAN_MAX_ACTIVATION_ATTEMPTS=5
# AUREOCLEAN_MAX_LOGIN_FAILURES=5
# AUREOCLEAN_LOGIN_LOCKOUT_MINUTES=15
# AUREOCLEAN_DATA_DIR=~/.local/share/aureoclean
# AUREOCLEAN_ARDUINO_CLOUD_URL=https://app.arduino.cc/
